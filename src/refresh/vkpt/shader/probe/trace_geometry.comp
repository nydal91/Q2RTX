#version 460
#extension GL_GOOGLE_include_directive : enable
// Driver compatibility probe: compiled as a compute shader with -DKHR_RAY_QUERY and
// created against the path tracer pipeline layout when the real shaders fail.
#include "../path_tracer_rgen.h"

Ray probe_ray()
{
	Ray r;
	r.origin = vec3(rt_LaunchID.xy, 0);
	r.direction = vec3(0, 0, 1);
	r.t_min = 0;
	r.t_max = 1000;
	return r;
}

void main()
{
	trace_geometry_ray(probe_ray(), true, PRIMARY_RAY_CULL_MASK);
	vec4 result = vec4(ray_payload_geometry.hit_distance, ray_payload_geometry.barycentric, float(ray_payload_geometry.primitive_id));
	imageStore(IMG_PT_MOTION, ivec2(rt_LaunchID.xy), result);
}
